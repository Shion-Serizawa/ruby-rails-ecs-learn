<% content_for :title, t(".title") %>

<div class="mx-auto max-w-md card">
  <h1 class="mb-5 text-2xl font-bold"><%= t(".title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :password, User.human_attribute_name(:password), class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>
    <div>
      <%= form.label :password_confirmation, User.human_attribute_name(:password_confirmation), class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>
    <%= form.submit t(".submit"), class: "btn-primary w-full" %>
  <% end %>
</div>
