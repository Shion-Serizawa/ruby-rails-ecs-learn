<%= form_with model: talk.new_record? ? [conference, talk] : talk, class: "card space-y-4" do |form| %>
  <%= render "shared/form_errors", record: talk %>

  <div>
    <%= form.label :title, class: "label" %>
    <%= form.text_field :title, required: true, maxlength: 200, class: "input" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :speaker, class: "label" %>
      <%= form.text_field :speaker, required: true, class: "input" %>
    </div>
    <div>
      <%= form.label :room, class: "label" %>
      <%= form.text_field :room, class: "input" %>
    </div>
    <div>
      <%= form.label :starts_at, class: "label" %>
      <%= form.datetime_local_field :starts_at, class: "input" %>
    </div>
    <div>
      <%= form.label :status, class: "label" %>
      <%= form.select :status, Talk.statuses.keys.map { [Talk.human_status(it), it] }, {}, class: "input" %>
    </div>
    <div>
      <%= form.label :rating, class: "label" %>
      <%= form.select :rating, (1..5).map { ["★" * it, it] }, { include_blank: t(".no_rating") }, class: "input" %>
    </div>
    <div>
      <%= form.label :tag_list, class: "label" %>
      <%= form.text_field :tag_list, placeholder: "ruby, performance", class: "input" %>
    </div>
  </div>
  <div data-controller="char-count">
    <%= form.label :notes, class: "label" %>
    <%= form.text_area :notes, rows: 10, placeholder: t(".notes_placeholder"), class: "input font-mono text-sm",
                               data: { char_count_target: "input", action: "input->char-count#update" } %>
    <p class="mt-1 text-right text-xs text-gray-500"><span data-char-count-target="output">0</span> 文字</p>
  </div>
  <div class="flex items-center gap-2">
    <%= form.check_box :favorite, class: "size-4" %>
    <%= form.label :favorite, class: "text-sm" %>
  </div>

  <div class="flex gap-3">
    <%= form.submit class: "btn-primary" %>
    <%= link_to t("shared.back"), talk.persisted? ? talk : conference, class: "btn-secondary" %>
  </div>
<% end %>
