<% content_for :title, @talk.title %>

<%= link_to "← #{@conference.name}", @conference, class: "text-sm link" %>

<article class="card mt-3">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold"><%= @talk.title %></h1>
      <p class="mt-1 text-gray-600"><%= @talk.speaker %></p>
    </div>
    <%= render "talks/favorite_button", talk: @talk %>
  </div>

  <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-4">
    <div><dt class="text-gray-500"><%= Talk.human_attribute_name(:starts_at) %></dt><dd><%= @talk.starts_at ? l(@talk.starts_at, format: :short) : "-" %></dd></div>
    <div><dt class="text-gray-500"><%= Talk.human_attribute_name(:room) %></dt><dd><%= @talk.room.presence || "-" %></dd></div>
    <div><dt class="text-gray-500"><%= Talk.human_attribute_name(:status) %></dt><dd><%= @talk.status_label %></dd></div>
    <div><dt class="text-gray-500"><%= Talk.human_attribute_name(:rating) %></dt><dd class="text-amber-500"><%= @talk.rating ? "★" * @talk.rating : "-" %></dd></div>
  </dl>

  <div class="mt-3 flex flex-wrap gap-1.5">
    <% @talk.tags.each do |tag| %>
      <%= link_to "##{tag.name}", conference_path(@conference, tag: tag.name), class: "chip" %>
    <% end %>
  </div>

  <div class="mt-6 border-t border-gray-100 pt-4">
    <% if @talk.notes.present? %>
      <div class="prose max-w-none text-sm leading-relaxed"><%= simple_format(@talk.notes) %></div>
    <% else %>
      <p class="text-sm text-gray-500"><%= t(".no_notes") %></p>
    <% end %>
  </div>

  <div class="mt-6 flex gap-2">
    <%= link_to t("shared.edit"), edit_talk_path(@talk), class: "btn-secondary" %>
    <%= button_to t("shared.destroy"), @talk, method: :delete, class: "btn-danger",
                                              form: { data: { turbo_confirm: t("shared.confirm_destroy") } } %>
  </div>
</article>
