<li id="<%= dom_id(talk) %>" class="card">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <%= link_to talk.title, talk, class: "font-semibold hover:underline" %>
      <p class="mt-1 text-sm text-gray-600">
        <%= talk.speaker %>
        <% if talk.starts_at %> · <%= l(talk.starts_at, format: :short) %><% end %>
        <% if talk.room.present? %> · <%= talk.room %><% end %>
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-1.5">
        <span class="chip"><%= talk.status_label %></span>
        <% if talk.rating %><span class="text-sm text-amber-500" aria-label="<%= Talk.human_attribute_name(:rating) %> <%= talk.rating %>"><%= "★" * talk.rating %></span><% end %>
        <% talk.tags.each do |tag| %>
          <span class="chip">#<%= tag.name %></span>
        <% end %>
      </div>
    </div>
    <%= render "talks/favorite_button", talk: talk %>
  </div>
</li>
