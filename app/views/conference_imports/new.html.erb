<% content_for :title, t(".title") %>

<%= link_to "← #{t("conferences.index.title")}", conferences_path, class: "text-sm link" %>
<h1 class="mt-2 mb-2 text-2xl font-bold"><%= t(".title") %></h1>
<p class="mb-6 text-sm text-gray-600"><%= t(".lead") %></p>

<section class="card mb-6">
  <h2 class="font-semibold"><%= t(".step1") %></h2>
  <p class="mt-1 text-sm text-gray-600"><%= t(".step1_help") %></p>

  <div class="mt-3 flex flex-wrap gap-2">
    <div data-controller="clipboard" data-clipboard-copied-label-value="<%= t(".copied") %>">
      <template data-clipboard-target="source"><%= conference_import_prompt %></template>
      <button type="button" class="btn-primary" data-clipboard-target="button" data-action="clipboard#copy"><%= t(".copy_prompt") %></button>
    </div>
    <div data-controller="clipboard" data-clipboard-copied-label-value="<%= t(".copied") %>">
      <template data-clipboard-target="source"><%= ConferenceImport.schema_json %></template>
      <button type="button" class="btn-secondary" data-clipboard-target="button" data-action="clipboard#copy"><%= t(".copy_schema") %></button>
    </div>
    <%= link_to t(".download_schema"), conference_import_schema_path(format: :json, download: 1), class: "btn-secondary", data: { turbo: false } %>
  </div>

  <details class="mt-4">
    <summary class="cursor-pointer text-sm text-gray-600"><%= t(".show_schema") %></summary>
    <pre class="mt-2 max-h-80 overflow-auto rounded-md bg-gray-900 p-3 text-xs text-gray-100"><%= ConferenceImport.schema_json %></pre>
  </details>
</section>

<section class="card">
  <h2 class="font-semibold"><%= t(".step2") %></h2>

  <%= form_with model: @import, url: conference_import_path, class: "mt-3 space-y-4" do |form| %>
    <%= render "shared/form_errors", record: @import %>
    <%= form.text_area :payload, rows: 16, required: true, spellcheck: false,
                                 placeholder: t(".payload_placeholder"), class: "input font-mono text-xs" %>
    <%= form.submit t(".submit"), class: "btn-primary" %>
  <% end %>
</section>
