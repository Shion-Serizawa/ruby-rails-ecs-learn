<%= form_with model: conference, class: "card space-y-4" do |form| %>
  <%= render "shared/form_errors", record: conference %>

  <div>
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, required: true, maxlength: 100, class: "input" %>
  </div>
  <div>
    <%= form.label :venue, class: "label" %>
    <%= form.text_field :venue, class: "input" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :starts_on, class: "label" %>
      <%= form.date_field :starts_on, required: true, class: "input" %>
    </div>
    <div>
      <%= form.label :ends_on, class: "label" %>
      <%= form.date_field :ends_on, required: true, class: "input" %>
    </div>
  </div>
  <div>
    <%= form.label :website_url, class: "label" %>
    <%= form.url_field :website_url, placeholder: "https://", class: "input" %>
  </div>

  <div class="flex gap-3">
    <%= form.submit class: "btn-primary" %>
    <%= link_to t("shared.back"), conference.persisted? ? conference : conferences_path, class: "btn-secondary" %>
  </div>
<% end %>
