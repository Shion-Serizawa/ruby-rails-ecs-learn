<% content_for :title, t(".title") %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <div class="flex gap-2">
    <%= link_to t(".import"), new_conference_import_path, class: "btn-secondary" %>
    <%= link_to t(".new"), new_conference_path, class: "btn-primary" %>
  </div>
</div>

<% if @conferences.any? %>
  <ul id="conferences" class="space-y-3">
    <%= render @conferences %>
  </ul>
  <div class="mt-6"><%== @pagy.series_nav %></div>
<% else %>
  <p class="card text-gray-500"><%= t(".empty") %></p>
<% end %>
