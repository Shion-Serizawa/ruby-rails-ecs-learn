# syntax=docker/dockerfile:1
# 開発用イメージ。本番用は Dockerfile (マルチステージ) を参照。
ARG RUBY_VERSION=4.0.9
FROM docker.io/library/ruby:$RUBY_VERSION

ARG UID=1000
ARG GID=1000

# postgresql-client: rails dbconsole 用 / chromium: system spec(headless) 用
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git libpq-dev libvips libyaml-dev pkg-config \
      postgresql-client chromium chromium-driver && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# ホストとUID/GIDを合わせ、生成ファイルがroot所有にならないようにする
RUN groupadd --gid $GID app && \
    useradd --uid $UID --gid $GID --create-home --shell /bin/bash app && \
    mkdir -p /usr/local/bundle /app && chown -R app:app /usr/local/bundle /app

ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_JOBS=4 \
    CHROME_BIN=/usr/bin/chromium \
    CHROMEDRIVER_PATH=/usr/bin/chromedriver

USER app
WORKDIR /app

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
