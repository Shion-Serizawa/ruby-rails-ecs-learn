#!/bin/bash -e

# RUN_DB_PREPARE=true のときだけ、Rails サーバ起動前に DB の作成/マイグレーションを行う。
#
# 既定で流さないのは、ECS で複数タスクが同時に起動 (desiredCount > 1、ローリングデプロイ) すると
# マイグレーションが競合してタスクが落ちるため。本番ではデプロイ前に単発タスク
# (command: ./bin/rails db:prepare) で流す。ローカルの compose.production.yaml では true にしている。
if [ "${RUN_DB_PREPARE}" == "true" ] && [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
